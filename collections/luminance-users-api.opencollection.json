          "http": {
            "method": "GET",
            "url": "https://{moniker}.app.luminance.com/api2/users",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "Unique user ID"
              },
              {
                "name": "username",
                "value": "",
                "type": "query",
                "description": "Username (login)"
              },
              {
                "name": "name",
                "value": "",
                "type": "query"
              },
              {
                "name": "email",
                "value": "",
                "type": "query"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "query",
                "description": "Associated account ID"
              },
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "User state (e.g. active)"
              },
              {
                "name": "multi_factor_auth_enabled",
                "value": "",
                "type": "query",
