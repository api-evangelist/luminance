          "docs": "Only Service Users with Administrator permissions can access this list."
        },
        {
          "info": {
            "name": "Get user by id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{moniker}.app.luminance.com/api2/users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get user by id"
        },
        {
          "info": {
            "name": "Get current user (the user associated with the authentication token)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{moniker}.app.luminance.com/api2/users/me",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
