          "http": {
            "method": "GET",
            "url": "https://{moniker}.app.luminance.com/projects/:project-id/matters/:matter-id/versions/:matter-version-id/assignable_users",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of objects that can be retrieved."
              },
              {
                "name": "username",
                "value": "",
                "type": "query",
                "description": "Username used in login credentials"
              },
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "Unique User ID"
              },
              {
                "name": "matter-id",
                "value": "",
                "type": "path",
                "description": "Matter Id"
              },
              {
                "name": "project-id",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "matter-version-id",
                "value": "",
                "type": "path",
                "description": "Matter Version Id"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://moniker.app.luminance.com/auth/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Gets a list of user names and IDs which can be assigned to a matter version"
        },
        {
          "info": {
            "name": "Assigns an available user to the matter version",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{moniker}.app.luminance.com/projects/:project-id/matters/:matter-id/versions/:matter-version-id/assign",
            "params": [
              {
                "name": "matter-id",
                "value": "",
                "type": "path",
                "description": "Matter Id"
              },
              {
                "name": "project-id",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "matter-version-id",
                "value": "",
                "type": "path",
                "description": "Matter Version Id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://moniker.app.luminance.com/auth/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Assigns an available user to the matter version"
        },
        {
          "info": {
            "name": "List users",
            "type": "http"
