{
  "opencollection": "1.0.0",
  "info": {
    "name": "Luminance Users API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Users Collection",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{moniker}.app.luminance.com/users",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "Unique User ID"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of objects that can be retrieved."
              },
              {
                "name": "created_at",
                "value": "2021-10-25T11:58:31.879Z",
                "type": "query",
                "description": "Time of Creation"
              },
              {
                "name": "created_by",
                "value": "4",
                "type": "query",
                "description": "User ID of Creator"
              },
              {
                "name": "username",
                "value": "",
                "type": "query",
                "description": "Username used in login credentials"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "query",
                "description": "ID of Associated Account this User is Added to"
              },
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "Current State of User"
              },
              {
                "name": "multi_factor_auth_enabled",
                "value": "",
                "type": "query",
                "description": "If `true` MFA is Enabled for this User"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://moniker.app.luminance.com/auth/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This endpoint provides a list of users available on the environment. Only Service Users with Administrator level permissions can access this list."
        },
        {
          "info": {
            "name": "Get a specific user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{moniker}.app.luminance.com/users/:user-id",
            "params": [
              {
                "name": "user-id",
                "value": "",
                "type": "path",
                "description": "User ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://moniker.app.luminance.com/auth/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get a user with the specific user id provided"
        },
        {
          "info": {
            "name": "Get Information on the User being used for Authentication",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{moniker}.app.luminance.com/users/me",
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://moniker.app.luminance.com/auth/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get Information on the User being used for Authentication"
        },
        {
          "info": {
            "name": "Get Information on the permissions assigned to users on a per project basis",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{moniker}.app.luminance.com/project_users",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "ID of the user permission object"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of objects that can be retrieved."
              },
              {
                "name": "created_at",
                "value": "2021-10-25T11:58:31.879Z",
                "type": "query",
                "description": "Time of Creation"
              },
              {
                "name": "created_by",
                "value": "4",
                "type": "query",
                "description": "User ID of Creator"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Type of the user in the user permission object, either 'admin' (Account Administrator) or 'standard'"
              },
              {
                "name": "roles",
                "value": "",
                "type": "query",
                "description": "Array of user permissions assigned to the user in the project defined in the user permissions object. A user may have multiple permission roles in a single project."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://moniker.app.luminance.com/auth/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get Information on the permissions assigned to users on a per project basis"
        },
        {
          "info": {
            "name": "Get Information on the user permissions object associated with a specific permissions object ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{moniker}.app.luminance.com/project_users/:project-user-id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "ID of the user permission object"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://moniker.app.luminance.com/auth/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get Information on the user permissions object associated with a specific permissions object ID"
        },
        {
