{
  "opencollection": "1.0.0",
  "info": {
    "name": "Luminance Root API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Root",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get System Data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/",
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://moniker.app.luminance.com/auth/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This endpoint provides system data, including: Luminance version, API2 version, and product type."
        }
      ]
    }
  ],
  "bundled": true
}