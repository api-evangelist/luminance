      "items": [
        {
          "info": {
            "name": "Get a list of tasks in a particular project, including alerts and knowledge banks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{moniker}.app.luminance.com/projects/:project-id/tasks",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of objects that can be retrieved."
              },
              {
                "name": "project-id",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "Unique Task ID(s)"
              },
              {
                "name": "moniker",
                "value": "",
                "type": "query",
                "description": "Shortened Name of Project"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Name of Task"
              },
              {
                "name": "created_by",
                "value": "4",
                "type": "query",
                "description": "User ID of Creator"
              },
              {
                "name": "description",
                "value": "",
                "type": "query",
                "description": "Task Description"
              },
              {
                "name": "auto_sync",
                "value": "",
                "type": "query",
                "description": "If auto-sync is automatic (true) or staging (false). If this is set to null then no auto-sync is run"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Type of Task - Knowledge Banks are 'precedent' type tasks"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://moniker.app.luminance.com/auth/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get a list of tasks in a particular project, including alerts and knowledge banks"
        },
