      },
      "items": [
        {
          "info": {
            "name": "Get Workflows available in a Project",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{moniker}.app.luminance.com/projects/:project-id/workflows",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "Unique Workflow ID"
              },
              {
                "name": "created_at",
                "value": "2021-10-25T11:58:31.879Z",
                "type": "query",
                "description": "Time of Creation"
              },
              {
                "name": "moniker",
                "value": "",
                "type": "query",
                "description": "Shortened Name of Project or Workflow"
              },
              {
                "name": "name",
                "value": "NDA Workflow",
                "type": "query",
                "description": "Name of workflow"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://moniker.app.luminance.com/auth/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get Workflows available in a Project"
        },
        {
          "info": {
            "name": "Get information on a single Workflow available in a Project",
            "type": "http"
          },
