            "params": [
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "Unique Workflow ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://moniker.app.luminance.com/auth/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get information on a single Workflow available in a Project"
        },
        {
          "info": {
