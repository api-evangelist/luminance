{
  "opencollection": "1.0.0",
  "info": {
    "name": "Luminance Public API v2 Annotation Types API",
    "version": "1.5"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Annotation Types",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List annotation types",
