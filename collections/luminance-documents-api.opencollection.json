        {
          "info": {
            "name": "Get Information on a Document collection",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{moniker}.app.luminance.com/projects/:project-id/documents",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of objects that can be retrieved."
              },
              {
                "name": "project-id",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "id",
                "value": "654",
                "type": "query",
                "description": "Unique Document ID"
              },
              {
                "name": "created_at",
                "value": "2021-10-25T11:58:31.879Z",
                "type": "query",
                "description": "Time of Creation"
              },
              {
                "name": "created_by",
                "value": "4",
                "type": "query",
                "description": "User ID of Creator"
              },
              {
                "name": "folder_id",
                "value": "6",
                "type": "query",
                "description": "Unique Folder ID(s)"
              },
              {
                "name": "parent_id",
                "value": "",
                "type": "query",
                "description": "If the document is part of a family of attachments, e.g. a document embedded on a PDF file or attached to an email"
              },
              {
                "name": "name",
                "value": "This is a contract.docx",
                "type": "query",
                "description": "Name of document"
              },
              {
                "name": "media_type",
                "value": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                "type": "query",
                "description": "MIME type detected for the document"
              },
              {
                "name": "state",
                "value": "import_complete",
                "type": "query",
                "description": "An 'upload_cancelled' document has been indexed by Luminance, but the upload was cancelled by the user while the process was occurring/. 'upload_failure' documents were not cancelled by the user, but the upload failed for some reason, for example an internet connection dropping. An 'import_pending' document has been uploaded but not analysed by Luminance's AI yet, which happens automatically to turn the document into an 'import_complete' document with document/annotations. If the document cannot be analysed, it becomes 'import_failure'."
              },
              {
                "name": "version_group",
                "value": "256",
                "type": "query",
                "description": "When a file with the same filename as another document in a particular folder, is uploaded to that folder, the existing document is set to document_versionState = 'replaced'. The new document version_group is set to the documentId of the 'replaced' document."
              },
              {
                "name": "version",
                "value": "2",
                "type": "query",
                "description": "if a file 'replaces' another file, its version will increment."
              },
              {
                "name": "version_state",
                "value": "active",
                "type": "query",
                "description": "When a file with the same filename as another document in a particular folder, is uploaded to that folder, the existing document is set to document_versionState = 'replaced'. The new document version_group is set to the documentId of the 'replaced' document. A 'draft' type version_state indicates the document is currently checked out via the Word Plugin and open for editing."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://moniker.app.luminance.com/auth/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get Information on a Document collection"
        },
